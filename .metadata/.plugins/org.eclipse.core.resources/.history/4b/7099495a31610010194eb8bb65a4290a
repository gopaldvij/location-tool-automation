	public void stripeSubmit(String cardnumber, String expiredate, String cvv) throws InterruptedException {
		driver.switchTo().frame(iframeStripe);
		Thread.sleep(1000);
		spreedlyCardNumebr.sendKeys(cardnumber);
		driver.switchTo().defaultContent();
		spreedlyCardExpireField.sendKeys(expiredate);
		driver.switchTo().frame(iframeCvv);
		spreedlyCvvField.sendKeys(cvv);
		driver.switchTo().defaultContent();
		Thread.sleep(2000);
		spreedlyCardSubmitBtn.click();
		Thread.sleep(20000);
	}

