	public void resetEnterPhoneNumberField() {
		// Ensure the element is focused
		Actions actions = new Actions(driver);
		enterPhoneNumberField.click();
		actions.moveToElement(enterPhoneNumberField).click().keyDown(Keys.CONTROL).sendKeys("a").keyUp(Keys.CONTROL)
				.sendKeys(Keys.BACK_SPACE) // Delete the selected text
				.perform();
	}

